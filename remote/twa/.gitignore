# Machine-specific SDK path — regenerated by whoever builds this.
local.properties

# Gradle/AGP build output — regenerate with gradlew.
build/
app/build/
.gradle/

# Built artifacts — not source, don't want binaries in git history.
*.apk
*.apk.idsig
*.aab
zipalign-check.log

# Signing key and its password — see .gitignore at repo root too.
*.keystore
keystore-credentials.txt
